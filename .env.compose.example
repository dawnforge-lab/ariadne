# Copy to .env.compose and replace EVERY value; never commit the copy.
# `scripts/compose-smoke.sh` generates a throwaway file of its own instead.
#   ARIADNE_API_TOKEN: >= 16 chars          (openssl rand -hex 24)
#   ARIADNE_METRICS_TOKEN: must differ      (openssl rand -hex 24)
#   ARIADNE_CREDENTIALS_KEY: <id>:<base64 of 32 bytes>   (echo "k1:$(openssl rand -base64 32)")
#   POSTGRES_PASSWORD: any
ARIADNE_API_TOKEN=REPLACE-ME-api-token-0000
ARIADNE_METRICS_TOKEN=REPLACE-ME-metrics-token-0000
ARIADNE_CREDENTIALS_KEY=k1:REPLACE-ME-WITH-base64-of-32-random-bytes
POSTGRES_PASSWORD=REPLACE-ME
ARIADNE_ALLOWED_DOMAINS=example.com
# Host port the API is published on (127.0.0.1 only).
ARIADNE_API_HOST_PORT=18787
